# Copy to .env.local for development. Placeholders only: never commit real values.
# In production, set these in Vercel > Project > Settings > Environment Variables.

# --- Existing ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-string>
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# --- Web push: public Firebase web app config (shipped to browsers, not secret) ---
# Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=<web-api-key>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair (public key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<vapid-public-key>

# --- Web push: Firebase Admin service account (SERVER ONLY, secret) ---
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_CLIENT_EMAIL=<service-account>@<project-id>.iam.gserviceaccount.com
# Paste the private key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n"
